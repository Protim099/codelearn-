# Copy to .env and fill in real values. NEVER commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
TIME_ZONE=Asia/Dhaka

# Database: mysql (default) or sqlite (quick local try-out)
DB_ENGINE=mysql
DB_NAME=codelearn
DB_USER=codelearn_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Code runner backend. Default is the DEMO runner that never executes code.
CODE_RUNNER=practice.runner.DemoRunner
